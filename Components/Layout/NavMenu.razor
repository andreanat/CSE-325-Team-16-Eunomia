@implements IDisposable
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Eunomia</a>
        <button class="nav-toggle" type="button" @onclick="ToggleNavigation"
            aria-label="Toggle navigation" aria-expanded="@(IsNavigationExpanded ? "true" : "false")">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</div>

<div class="nav-scrollable @(IsNavigationExpanded ? "expanded" : "")">
    <nav class="nav flex-column">
        @if (UserSession.IsLoggedIn && UserSession.CurrentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavigation">
                    <span class="bi bi-house-door-fill-nav-menu me-2" aria-hidden="true">📖</span> Dashboard &amp; library
                </NavLink>
            </div>
            <div class="px-3 my-3">
                <div class="p-2 rounded" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);">
                    <div class="small text-white-50 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Signed In As</div>
                    <div class="fw-bold text-white text-truncate small">@UserSession.CurrentUser.FirstName @UserSession.CurrentUser.LastName</div>
                    <div class="text-white-50 text-truncate font-monospace" style="font-size: 0.75rem;">@@@UserSession.CurrentUser.Username</div>
                </div>
            </div>

            <div class="nav-item px-3">
                <button class="btn btn-outline-light btn-sm w-100 text-start d-flex align-items-center" style="background: transparent; border-color: rgba(255, 255, 255, 0.25); color: #fff;" @onclick="HandleLogout">
                    <span class="me-2">🚪</span> Log out
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login" @onclick="CloseNavigation">
                    <span class="me-2" aria-hidden="true">🔑</span> Log in
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register" @onclick="CloseNavigation">
                    <span class="me-2" aria-hidden="true">✨</span> Register
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool IsNavigationExpanded;

    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
    }

    private void ToggleNavigation() => IsNavigationExpanded = !IsNavigationExpanded;

    private void CloseNavigation() => IsNavigationExpanded = false;

    private void HandleLogout()
    {
        UserSession.ClearUser();
        CloseNavigation();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
