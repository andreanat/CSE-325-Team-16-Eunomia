@inherits LayoutComponentBase
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        EnforceAuthentication();
    }

    protected override void OnParametersSet()
    {
        EnforceAuthentication();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        EnforceAuthentication();
    }

    private void EnforceAuthentication()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        var path = relative.Split('?', '#')[0];

        var isPublic = string.Equals(path, "login", StringComparison.OrdinalIgnoreCase) ||
                       string.Equals(path, "register", StringComparison.OrdinalIgnoreCase) ||
                       string.Equals(path, "Error", StringComparison.OrdinalIgnoreCase);

        if (!UserSession.IsLoggedIn && !isPublic)
        {
            Navigation.NavigateTo("login");
        }
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
