@page "/login"
@inject IUserService UserService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>Login | Eunomia</PageTitle>

<div class="container py-4" style="max-width: 960px;">
    <div class="row g-4 align-items-start">
        <!-- Login Card -->
        <div class="col-12 col-lg-6">
            <div class="card p-4 shadow-sm">
                <div class="mb-4">
                    <p class="text-uppercase small fw-bold text-success mb-1" style="letter-spacing: 1px;">Member Access</p>
                    <h2 class="h3 mb-2" style="font-family: Georgia, serif;">Sign in to Eunomia</h2>
                    <p class="text-muted small mb-0">Enter your credentials to access your personal media journal.</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3 py-2 px-3 small" role="alert">
                        <span class="me-2 fw-bold">⚠</span>
                        <div>@ErrorMessage</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="alert alert-success d-flex align-items-center mb-3 py-2 px-3 small" role="alert">
                        <span class="me-2 fw-bold">✓</span>
                        <div>@SuccessMessage</div>
                    </div>
                }

                <EditForm Model="Model" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="login-username">Username</label>
                        <InputText id="login-username" class="form-control" @bind-Value="Model.Username" placeholder="e.g. alex.morgan" autocomplete="username" />
                        <ValidationMessage For="() => Model.Username" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="login-password">Password</label>
                        <InputText id="login-password" type="password" class="form-control" @bind-Value="Model.Password" placeholder="••••••••" autocomplete="current-password" />
                        <ValidationMessage For="() => Model.Password" class="text-danger small mt-1" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                        }
                    </button>
                </EditForm>

                <div class="text-center pt-2 border-top">
                    <span class="text-muted small">Don't have an account yet? </span>
                    <a href="register" class="small fw-semibold text-decoration-none">Create an account</a>
                </div>
            </div>
        </div>

        <!-- 10 Demo Accounts Helper Box -->
        <div class="col-12 col-lg-6">
            <div class="card p-4 bg-light border-0">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-secondary mb-2">Test & Grading Hub</span>
                        <h4 class="h5 mb-1" style="font-family: Georgia, serif;">10 Pre-Loaded Fake Accounts</h4>
                    </div>
                </div>
                <p class="text-muted small mb-3">
                    These 10 accounts are already saved in the PostgreSQL database with passwords securely hashed via BCrypt. Click <strong>"Fill"</strong> to instantly populate the login fields with any account.
                </p>

                <div class="p-2 mb-3 bg-white rounded border small d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted">Universal Demo Password:</span>
                        <code class="fw-bold ms-1 text-primary">Password123!</code>
                    </div>
                </div>

                @if (IsLoadingAccounts)
                {
                    <div class="text-center py-3 text-muted small">
                        <span class="spinner-border spinner-border-sm me-2"></span> Loading accounts from PostgreSQL...
                    </div>
                }
                else if (DemoAccounts.Count == 0)
                {
                    <div class="text-muted small">No accounts found in database.</div>
                }
                else
                {
                    <div class="list-group list-group-flush border rounded bg-white" style="max-height: 380px; overflow-y: auto;">
                        @foreach (var acc in DemoAccounts)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3">
                                <div style="min-width: 0;" class="me-2">
                                    <div class="fw-semibold text-truncate small">@acc.FirstName @acc.LastName</div>
                                    <div class="text-muted text-truncate" style="font-size: 0.78rem;">
                                        <code>@@@acc.Username</code> &bull; @acc.Email
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.75rem; min-height: unset;" @onclick="() => AutofillAccount(acc.Username)">
                                    Fill
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel Model = new();
    private List<UserAccount> DemoAccounts = new();
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsSubmitting;
    private bool IsLoadingAccounts = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            DemoAccounts = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load users from database: {ex.Message}";
        }
        finally
        {
            IsLoadingAccounts = false;
        }
    }

    private void AutofillAccount(string username)
    {
        Model.Username = username;
        Model.Password = DbInitializer.DefaultDemoPassword;
        ErrorMessage = null;
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;

        try
        {
            var result = await UserService.LoginAsync(Model.Username, Model.Password);
            if (result.Success && result.User != null)
            {
                UserSession.SetUser(result.User);
                SuccessMessage = $"Welcome back, {result.User.FirstName}! Redirecting...";
                await Task.Delay(400);
                Navigation.NavigateTo("/");
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}

