@page "/"
@inject IUserService UserService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IMediaService MediaService

<PageTitle>Eunomia | Personal Media Tracker</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="container py-5 text-center">
        <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Redirecting to login...</p>
    </div>
}
else
{
    <div class="container journal-shell py-4">
        <header class="journal-header mb-4">
            <div>
                <p class="journal-kicker mb-2"><span class="journal-kicker-mark"></span> Eunomia <span
                    class="kicker-divider">/</span> Personal media journal</p>
                    <h1 class="journal-title mb-2">A good story stays with you.</h1>
                    <p class="journal-intro mb-0">A considered record of what you watch, read, play, and return to.</p>
                </div>
                <div class="journal-stamp" aria-label="Personal archive, five categories">
                    <span>PERSONAL</span>
                    <strong>ARCHIVE</strong>
                    <span>FIVE CATEGORIES</span>
                </div>
            </header>

            <section class="row g-3 mb-4" aria-label="Media activity summary">
                <div class="col-sm-4">
                    <button type="button" class="summary-tile summary-completed h-100 w-100 text-start"
                            @onclick='() => SetStatusFilter("Completed")' aria-pressed="@(SelectedStatus == "Completed")">
                        <span class="summary-index">01 / FINISHED</span>
                        <span class="summary-label">Completed</span>
                        <span class="summary-bottom"><strong class="summary-count">@CountByStatus("Completed")</strong><span
                            class="summary-caption">items finished</span></span>
                        </button>
                    </div>

                    <div class="col-sm-4">
                        <button type="button" class="summary-tile summary-current h-100 w-100 text-start"
                                @onclick='() => SetStatusFilter("Currently Enjoying")'
                                aria-pressed="@(SelectedStatus == "Currently Enjoying")">
                            <span class="summary-index">02 / IN PROGRESS</span>
                            <span class="summary-label">Currently enjoying</span>
                            <span class="summary-bottom"><strong class="summary-count">@CountByStatus("Currently Enjoying")</strong><span class="summary-caption">in progress</span></span>
                        </button>
                    </div>

                    <div class="col-sm-4">
                        <button type="button" class="summary-tile summary-queued h-100 w-100 text-start"
                                @onclick='() => SetStatusFilter("Want to Try")' aria-pressed="@(SelectedStatus == "Want to Try")">
                            <span class="summary-index">03 / ON THE LIST</span>
                            <span class="summary-label">Want to try</span>
                            <span class="summary-bottom"><strong class="summary-count">@CountByStatus("Want to Try")</strong><span
                                class="summary-caption">saved for later</span></span>
                            </button>
                        </div>
                    </section>

                    <section class="library-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <p class="section-kicker mb-1">YOUR COLLECTION</p>
                            <h2 class="library-title mb-1">The library</h2>
                            <p class="text-secondary mb-0">@CurrentMediaItems.Count() titles, kept in one place</p>
                        </div>
                        <button class="btn btn-primary add-media-button" @onclick="NewMediaItem"><span aria-hidden="true">+</span> Add a
                            title</button>
                        </section>

                        <section class="filter-bar mb-4" aria-label="Search and filter media">
                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <label class="form-label fw-semibold" for="media-search">Search</label>
                                    <input id="media-search" class="form-control" @bind="SearchTerm" @bind:event="oninput"
                                           placeholder="Title or notes" />
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <label class="form-label fw-semibold" for="category-filter">Category</label>

                                    <select id="category-filter" class="form-select" @bind="SelectedCategory">

                                        <option value="All">All categories</option>

                                        @foreach (var category in Categories)
                                        {
                                            <option value="@category">@category</option>
                                        }

                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <label class="form-label fw-semibold" for="status-filter">Status</label>

                                    <select id="status-filter" class="form-select" @bind="SelectedStatus">

                                        <option value="All">All statuses</option>

                                        @foreach (var status in Statuses)
                                        {
                                            <option value="@status">@status</option>
                                        }

                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <label class="form-label fw-semibold" for="sort-order">Sort by</label>

                                    <select id="sort-order" class="form-select" @bind="SelectedSort">

                                        <option value="Title">Title</option>
                                        <option value="Rating">Rating</option>
                                        <option value="Recently added">Recently added</option>

                                    </select>
                                </div>
                            </div>
                        </section>

                        @if (FilteredMediaItems.Any())
                        {
                            <div class="row g-3">

                                @foreach (var item in FilteredMediaItems)
                                {
                                    <div class="col-12 col-sm-6 col-xl-4">
                                        <article class="library-card h-100">
                                            <div class="library-card-body d-flex flex-column">
                                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">

                                                    <div>
                                                        <p class="category-label mb-2">@item.Category <span aria-hidden="true">/</span>
                                                            #@item.Id.ToString("00")</p>
                                                            <h3 class="media-title mb-0">@item.Title</h3>
                                                        </div>

                                                        <span class="badge @StatusBadgeClass(item.Status)">
                                                            @item.Status
                                                        </span>

                                                    </div>
                                                    <p class="media-rating mb-3">@(item.Rating is null ? "Not rated yet" : $"Rated {item.Rating} out of 10")</p>
                                                    <label class="form-label small fw-semibold" for="status-@item.Id">Reading status</label>
                                                    <select id="status-@item.Id" class="form-select form-select-sm mb-3" value="@item.Status"
                                                            @onchange="args => UpdateStatus(item.Id, args)">
                                                        @foreach (var status in Statuses)
                                                        {
                                                            <option value="@status">@status</option>
                                                        }

                                                    </select>
                                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowDetails(item.Id)">View
                                                            details</button>
                                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditItem(item)">Edit
                                                                details</button>
                                                                <button class="btn btn-sm btn-outline-danger"
                                                                        @onclick="() => RequestDelete(item.Id)">Delete</button>
                                                            </div>

                                                        </div>

                                                    </article>

                                                </div>
                                            }

                                        </div>
                                    }
    else
                                    {
                                        <div class="border rounded p-5 text-center">

                                            <h3 class="h5">No media found</h3>

                                            <p class="text-secondary mb-0">
                                                Add a title or adjust your search and filters.
                                            </p>

                                        </div>
                                    }

                                    @if (SelectedItem is not null)
                                    {
                                        <div class="media-modal-backdrop" @onkeydown="HandleModalKeyDown">
                                            <section class="media-modal" role="dialog" aria-modal="true" aria-labelledby="media-detail-title">
                                                <div class="media-modal-header">
                                                    <div>
                                                        <p class="small text-uppercase text-secondary fw-semibold mb-1">@SelectedItem.Category</p>
                                                        <h2 id="media-detail-title" class="h3 mb-0">@SelectedItem.Title</h2>
                                                    </div>
                                                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetails"
                                                            aria-label="Close details">Close</button>
                                                </div>
                                                <dl class="row media-detail-list">
                                                    <dt class="col-sm-4">Status</dt>
                                                    <dd class="col-sm-8"><span
                                                        class="badge @StatusBadgeClass(SelectedItem.Status)">@SelectedItem.Status</span></dd>
                                                        <dt class="col-sm-4">Rating</dt>
                                                        <dd class="col-sm-8">@(SelectedItem.Rating is null ? "Not rated" : $"{SelectedItem.Rating}/10")</dd>
                                                        <dt class="col-sm-4">Started</dt>
                                                        <dd class="col-sm-8">@(SelectedItem.StartedOn?.ToString("MMM d, yyyy") ?? "Not set")</dd>
                                                        <dt class="col-sm-4">Completed</dt>
                                                        <dd class="col-sm-8">@(SelectedItem.CompletedOn?.ToString("MMM d, yyyy") ?? "Not set")</dd>
                                                        <dt class="col-sm-4">Added</dt>
                                                        <dd class="col-sm-8">@SelectedItem.DateAdded.ToString("MMM d, yyyy")</dd>
                                                        <dt class="col-sm-4">Notes</dt>
                                                        <dd class="col-sm-8 notes-value">@(string.IsNullOrWhiteSpace(SelectedItem.Notes) ? "No notes" :
                                                                                SelectedItem.Notes)</dd>
                                                        </dl>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            <button type="button" class="btn btn-primary" @onclick="EditSelectedItem">Edit item</button>
                                                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetails">Close</button>
                                                        </div>
                                                    </section>
                                                </div>
                                            }

                                            @if (IsEditing)
                                            {
                                                <div class="media-modal-backdrop" @onkeydown="HandleModalKeyDown">
                                                    <section class="media-modal" role="dialog" aria-modal="true" aria-labelledby="media-editor-title">
                                                        <div class="media-modal-header">
                                                            <h2 id="media-editor-title" class="h4 mb-0">@(EditingItem.Id == 0 ? "Add to your library" : $"Edit             {EditingItem.Title}")</h2>
                                                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit"
                                                                    aria-label="Close editor">Close</button>
                                                        </div>
                                                        <EditForm Model="EditingItem" OnValidSubmit="SaveItem">

                                                            <DataAnnotationsValidator />

                                                            <ValidationSummary class="text-danger mb-3" />

                                                            <div class="row g-3">

                                                                <div class="col-md-6">

                                                                    <label class="form-label" for="item-title">
                                                                        Title
                                                                    </label>

                                                                    <InputText id="item-title" class="form-control" @bind-Value="EditingItem.Title" />

                                                                    <ValidationMessage For="@(() => EditingItem.Title)" class="text-danger" />

                                                                </div>

                                                                <div class="col-md-3">

                                                                    <label class="form-label" for="item-category">
                                                                        Category
                                                                    </label>

                                                                    <InputSelect id="item-category" class="form-select" @bind-Value="EditingItem.Category">

                                                                        @foreach (var category in Categories)
                                                                        {
                                                                            <option value="@category">
                                                                                @category
                                                                            </option>
                                                                        }

                                                                    </InputSelect>

                                                                </div>

                                                                <div class="col-md-3">

                                                                    <label class="form-label" for="item-status">
                                                                        Status
                                                                    </label>

                                                                    <InputSelect id="item-status" class="form-select" @bind-Value="EditingItem.Status">

                                                                        @foreach (var status in Statuses)
                                                                        {
                                                                            <option value="@status">
                                                                                @status
                                                                            </option>
                                                                        }

                                                                    </InputSelect>

                                                                </div>

                                                                <div class="col-md-4">

                                                                    <label class="form-label" for="item-rating">
                                                                        Rating (1-10)
                                                                    </label>

                                                                    <InputNumber id="item-rating" class="form-control" @bind-Value="EditingItem.Rating" min="1"
                                                                                 max="10" />

                                                                    <ValidationMessage For="@(() => EditingItem.Rating)" class="text-danger" />

                                                                </div>

                                                                <div class="col-md-4">

                                                                    <label class="form-label" for="item-started">
                                                                        Start date
                                                                    </label>

                                                                    <InputDate id="item-started" class="form-control" @bind-Value="EditingItem.StartedOn" />

                                                                </div>

                                                                <div class="col-md-4">

                                                                    <label class="form-label" for="item-completed">
                                                                        Completion date
                                                                    </label>

                                                                    <InputDate id="item-completed" class="form-control" @bind-Value="EditingItem.CompletedOn" />

                                                                </div>

                                                                <div class="col-12">

                                                                    <label class="form-label" for="item-notes">
                                                                        Notes
                                                                    </label>

                                                                    <InputTextArea id="item-notes" class="form-control" @bind-Value="EditingItem.Notes" rows="3" />

                                                                    <ValidationMessage For="@(() => EditingItem.Notes)" class="text-danger" />

                                                                </div>

                                                            </div>

                                                            <div class="d-flex gap-2 mt-4">

                                                                <button type="submit" class="btn btn-primary">
                                                                    Save item
                                                                </button>

                                                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                                    Cancel
                                                                </button>

                                                            </div>

                                                        </EditForm>
                                                    </section>
                                                </div>
                                            }

                                            @if (PendingDeleteItem is not null)
                                            {
                                                <div class="media-modal-backdrop" @onkeydown="HandleModalKeyDown">
                                                    <section class="media-modal media-confirm-modal" role="alertdialog" aria-modal="true"
                                                             aria-labelledby="delete-confirm-title">
                                                        <h2 id="delete-confirm-title" class="h4">Remove this item?</h2>
                                                        <p>“@PendingDeleteItem.Title” will be removed from your library.</p>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Remove item</button>
                                                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                                        </div>
                                                    </section>
                                                </div>
                                            }

                                            <section class="border-top mt-5 pt-4">

                                                <div class="row g-3 align-items-end">

                                                    <div class="col-md-6">

                                                        <label class="form-label fw-semibold" for="active-account">
                                                            Personal collection
                                                        </label>

                                                        <select id="active-account" class="form-select" value="@CurrentUser.Id" @onchange="SwitchAccount">

                                                            @foreach (var account in Accounts)
                                                            {
                                                                <option value="@account.Id">
                                                                    @account.Name (@account.Email)
                                                                </option>
                                                            }

                                                        </select>

                                                    </div>

                                                    <div class="col-md-6 d-flex flex-wrap gap-2">
                                                        <a href="login" class="btn btn-outline-primary">Sign in with an account</a>
                                                        <a href="register" class="btn btn-primary">+ Register new user</a>
                                                    </div>

                                                </div>

                                                <div class="mt-3">
                                                    <p class="small text-secondary mb-0">
                                                        <span class="text-success fw-bold">● Database Connected:</span> All accounts and credentials are saved
                                                        in PostgreSQL with secure BCrypt password hashing.
                                                    </p>
                                                </div>

                                            </section>

                                        </div>
                                    }

@code {

    private static readonly List<string> Categories = new()
    {
        "Movies",
        "TV Shows",
        "Books",
        "Music",
        "Games"
    };

    private static readonly List<string> Statuses = new()
    {
        "Completed",
        "Currently Enjoying",
        "Want to Try"
    };

    private string SearchTerm = "";

    private string SelectedCategory = "All";

    private string SelectedStatus = "All";

    private string SelectedSort = "Title";

    private bool IsEditing;

    private int? SelectedItemId;
    private int? PendingDeleteItemId;

    private MediaItem EditingItem = new();

    private List<UserAccount> Accounts = new();

    private UserAccount CurrentUser =>
        Accounts.FirstOrDefault(account => account.Id == CurrentUserId)
        ?? Accounts.FirstOrDefault()
        ?? new UserAccount { FirstName = "Guest", Email = "guest@eunomia.app" };

    private int CurrentUserId = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        try
        {
            var dbUsers = await UserService.GetAllUsersAsync();
            if (dbUsers.Any())
            {
                Accounts = dbUsers;
                if (UserSession.CurrentUser != null && Accounts.Any(a => a.Id == UserSession.CurrentUser.Id))
                {
                    CurrentUserId = UserSession.CurrentUser.Id;
                }
                else
                {
                    CurrentUserId = Accounts.First().Id;
                }
            }

            await LoadMediaItemsAsync();
        }
        catch
        {
            // Fallback gracefully if database is unreachable
        }
    }

    private async Task LoadMediaItemsAsync()
    {
        try
        {
            MediaItems = await MediaService.GetMediaItemsByUserAsync(CurrentUserId);
        }
        catch
        {
            MediaItems = new();
        }
    }

    private MediaItem? SelectedItem => MediaItems.FirstOrDefault(item => item.Id == SelectedItemId && item.UserId ==
CurrentUserId);
    private MediaItem? PendingDeleteItem => MediaItems.FirstOrDefault(item => item.Id == PendingDeleteItemId && item.UserId
== CurrentUserId);

    private List<MediaItem> MediaItems = new();

    private IEnumerable<MediaItem> CurrentMediaItems => MediaItems;

    private IEnumerable<MediaItem> FilteredMediaItems
    {
        get
        {
            var items = CurrentMediaItems
                .Where(item =>
                    string.IsNullOrWhiteSpace(SearchTerm) ||
                    item.Title.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase) ||
                    item.Notes.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase))
                .Where(item =>
                    SelectedCategory == "All" ||
                    item.Category == SelectedCategory)
                .Where(item =>
                    SelectedStatus == "All" ||
                    item.Status == SelectedStatus);

            return SelectedSort switch
            {
                "Rating" =>
                    items.OrderByDescending(item => item.Rating ?? 0),

                "Recently added" =>
                    items.OrderByDescending(item => item.DateAdded),

                _ =>
                    items.OrderBy(item => item.Title)
            };
        }
    }

    private int CountByStatus(string status) =>
        CurrentMediaItems.Count(item => item.Status == status);

    private void SetStatusFilter(string status)
    {
        SelectedStatus =
            SelectedStatus == status
                ? "All"
                : status;
    }

    private void ShowDetails(int id) => SelectedItemId = id;

    private void CloseDetails() => SelectedItemId = null;

    private void EditSelectedItem()
    {
        if (SelectedItem is { } item)
        {
            EditItem(item);
            CloseDetails();
        }
    }

    private async Task UpdateStatus(
        int id,
        ChangeEventArgs args)
    {
        var status =
            args.Value?.ToString();

        if (string.IsNullOrEmpty(status) ||
            !Statuses.Contains(status))
        {
            return;
        }

        await MediaService.UpdateStatusAsync(id, CurrentUserId, status);
        await LoadMediaItemsAsync();
    }

    private static string StatusBadgeClass(string status) =>
        status switch
        {
            "Completed" =>
                "text-bg-success",

            "Currently Enjoying" =>
                "text-bg-primary",

            _ =>
                "text-bg-warning"
        };

    private void NewMediaItem()
    {
        EditingItem =
            new MediaItem
            {
                Category = "Movies",
                Status = "Want to Try"
            };

        IsEditing = true;
    }

    private void EditItem(MediaItem item)
    {
        EditingItem =
            new MediaItem
            {
                Id = item.Id,
                UserId = item.UserId,
                Title = item.Title,
                Category = item.Category,
                Status = item.Status,
                Rating = item.Rating,
                Notes = item.Notes,
                StartedOn = item.StartedOn,
                CompletedOn = item.CompletedOn,
                DateAdded = item.DateAdded
            };

        IsEditing = true;
    }

    private async Task SaveItem()
    {
        await MediaService.SaveMediaItemAsync(EditingItem, CurrentUserId);
        await LoadMediaItemsAsync();
        CancelEdit();
    }

    private void RequestDelete(int id) => PendingDeleteItemId = id;

    private async Task ConfirmDelete()
    {
        if (PendingDeleteItemId is int id)
        {
            await MediaService.DeleteMediaItemAsync(id, CurrentUserId);
            if (SelectedItemId == id)
            {
                CloseDetails();
            }
            await LoadMediaItemsAsync();
        }

        PendingDeleteItemId = null;
    }

    private void CancelDelete() => PendingDeleteItemId = null;

    // Dismiss the active modal when Escape is pressed within it.
    private void HandleModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        if (PendingDeleteItemId is not null)
        {
            CancelDelete();
        }
        else if (IsEditing)
        {
            CancelEdit();
        }
        else if (SelectedItemId is not null)
        {
            CloseDetails();
        }
    }

    private void CancelEdit()
    {
        EditingItem =
            new MediaItem();

        IsEditing =
            false;
    }


    private async Task SwitchAccount(ChangeEventArgs args)
    {
        if (int.TryParse(
                args.Value?.ToString(),
                out var userId) &&
            Accounts.Any(
                account =>
                    account.Id == userId))
        {
            CurrentUserId =
                userId;

            CancelEdit();
            await LoadMediaItemsAsync();
        }
    }
}
